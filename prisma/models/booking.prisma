model Booking {
  id             String        @id @default(uuid())
  status         BookingStatus @default(REQUESTED)
  startAt        DateTime
  endAt          DateTime
  priceAtBooking Decimal       @db.Decimal(10, 2)

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  availabilitySlotId String
  availabilitySlot   AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  review Review?
  items BookingItem[]

  @@index([customerId])
  @@index([serviceId])
  @@index([availabilitySlotId])
  @@map("bookings")
}

model BookingItem {
  bookingId       String
  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  position        Int
  title           String
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int

  @@id([bookingId, serviceId])
  @@unique([bookingId, position])
  @@index([serviceId])
  @@map("booking_items")
}
