# Copy this file to .env and fill in the blank values. Never commit .env.

PORT=8001
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fixitnow?schema=public

# Allowed frontend origin for CORS. Replace when you have a frontend.
APP_URL=http://localhost:3000
# Public base URL of this backend, used for Stripe Checkout return links.
SERVER_URL=http://127.0.0.1:8001

BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=1d

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currently declared in config but not used by the Stripe Checkout code.
STRIPE_PRODUCT_PRICE_ID=

# Used by prisma/seed.ts to create the initial admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
